# --- Base de datos ---------------------------------------------------------
DATABASE_URL=postgres://usuario:clave@localhost:5432/procovar_rutas?sslmode=disable

# --- Servidor --------------------------------------------------------------
PUERTO=3600
ENTORNO=dev            # dev | prod  (en prod la cookie va con Secure)
APP_URL=http://localhost:3600

# --- procovar-auth ---------------------------------------------------------
# Alta previa en el seed de procovar-auth (ver docs/CONSUMER-PATTERN.md allí).
QB_AUTH_URL=http://localhost:3500
QB_AUTH_CLIENT_ID=procovar-rutas
QB_AUTH_SIGNING_KEY=          # 64 caracteres hex, los imprime el seed de auth
# Solo si todas las aplicaciones cuelgan del mismo dominio raíz. Sin esto la
# cookie es del host, que es lo correcto cuando no lo comparten.
# QB_SESSION_COOKIE_DOMAIN=.procovar.cloud

# --- Google Drive ----------------------------------------------------------
# Hay una cuenta de Google por sucursal, PERO todas las carpetas están además
# compartidas en la cuenta padre `tablets.procovar`: con esa sola credencial se
# ven todas. Por eso basta con una entrada, "principal".
#
# Dentro de cada carpeta hay una subcarpeta por perfil de GPS (nombre del
# vendedor o de la tableta) y dentro los ficheros AAAAMMDD.gpx.
#
# Si algún día hiciera falta leer una sucursal con su propia cuenta, se añade
# otra entrada aquí y se pone su clave en el campo `credencial` de esa carpeta.
# Los tokens se consiguen uno a uno con:
#
#   go run ./cmd/autorizar -clave granma -client-id … -client-secret …
#
# El permiso pedido es de SOLO LECTURA: este sistema nunca mueve ni borra nada
# del Drive de los trabajadores.
GOOGLE_CUENTAS=[{"clave":"principal","tipo":"oauth","clientId":"…","clientSecret":"…","refreshToken":"…"}]
# Alternativa, para no meter secretos en el entorno:
# GOOGLE_CUENTAS_FILE=/etc/procovar-rutas/cuentas.json

# --- Redis y n8n -----------------------------------------------------------
# n8n empuja los .gpx a POST /api/ingesta/fichero; la API los encola aquí y el
# servicio de ingesta los procesa. El prefijo mantiene las claves separadas de
# las de PEDIDO (procovar-pedido:*) en el mismo Redis.
REDIS_URL=redis://localhost:6379/0
PREFIJO_REDIS=procovar-rutas:

# La clave con la que n8n se identifica. Mismo valor en el entorno de n8n como
# RUTAS_API_KEY. Sin ella, la puerta de servicio está cerrada.
SERVICE_API_KEY=

# --- PEDIDO: los pedidos del día -------------------------------------------
# De aquí salen los clientes CON SU GEOLOCALIZACIÓN y los pedidos de cada día, que
# es contra lo que se contrasta el recorrido: 30 km no dicen nada —se hacen igual
# dando vueltas—, pero «pasó por 6 de sus 8 clientes» sí.
#
# La dirección es la INTERNA del contenedor de PEDIDO. Los dos cuelgan de la misma
# red de Docker en Dokploy (`dokploy-network`), así que el tráfico no sale de la
# máquina: ni vuelta pública, ni TLS que negociar, ni nada que publicar. El nombre
# exacto del contenedor sale de Dokploy.
#
# Sin esto, el panel funciona igual que siempre: sencillamente no pinta la columna
# de clientes en vez de pintar un cero que se leería como «no visitó a nadie».
PEDIDO_API_URL=http://procovar-api:8400
# La misma llave de servicio que ya usa delivery contra PEDIDO (su SERVICE_API_KEY).
# Si no se pone, se reutiliza SERVICE_API_KEY.
PEDIDO_API_KEY=
# Días hacia atrás que se traen en cada pasada. El calendario mira la semana en
# curso y la anterior; tres semanas cubren eso con margen.
PEDIDO_VENTANA_DIAS=21
# Cada cuánto PLANIFICA. El planificador no habla con PEDIDO: sólo mira el calendario
# y deja días en la cola, así que puede pasar a menudo sin que eso sea más carga.
INTERVALO_PEDIDOS=15m
# LA PAUSA ENTRE UN DÍA Y EL SIGUIENTE, y el único mando que decide cuánta carga ve
# PEDIDO: el trabajador coge un día, lo trae, lo cruza, espera esto, y coge el
# siguiente. Nunca hace dos cosas a la vez. Subir este número es la forma de dejar a
# PEDIDO todavía más tranquilo; ponerlo en 0 lo deja sin freno y no es buena idea.
PAUSA_PEDIDOS=5s

# --- Ingesta ---------------------------------------------------------------
# El incremental puede ir tranquilo: el repaso nocturno completo es el que
# garantiza que no falte nada.
INTERVALO_BARRIDO=30m
HORA_REPASO_NOCTURNO=2
MAX_FICHEROS_BARRIDO=500

# --- Pruebas ---------------------------------------------------------------
# Las de integración se saltan solas si no está puesta.
# DATABASE_URL_TEST=postgres://postgres:prueba@127.0.0.1:55432/postgres?sslmode=disable
